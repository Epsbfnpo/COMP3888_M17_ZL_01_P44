    "recommended_integration_order": [
      "Validate this JSON at startup and reject duplicate workflow_id or rule_id values.",
      "Add workflow_id and modifiers to the submitter UI and submission.json.",
      "Normalize submission data into metadata/submitter-declaration and metadata/ai-disclosure records.",
      "Evaluate common required rules, then workflow required rules, then triggered conditional rules.",
      "Exclude optional rules from the completeness denominator while still validating and reporting them.",
      "Return per-rule status: satisfied, missing, not_assessed, not_applicable, or invalid.",
      "Calculate completeness value only from assessed applicable required and conditional rules, and report assessment coverage separately in confidence.",
      "Version this policy whenever workflows, triggers, weights, or artefact expectations change."
    ],
    "client_review_required_for": [
      "Whether required and conditional classifications match real client workflows",
      "Whether any optional evidence should become mandatory for a particular delivery contract",
      "Rule weights and confidence ceilings",
      "Legal or rights-document scope"
    ]
