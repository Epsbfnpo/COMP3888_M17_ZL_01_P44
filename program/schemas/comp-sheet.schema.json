{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "COMP3888 canonical CompSheet 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sheet_type", "selections"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "sheet_type": { "const": "comp" },
    "song_title": { "type": "string", "minLength": 1 },
    "comp_name": { "type": "string", "minLength": 1 },
    "target_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "selections": {
      "type": "array", "minItems": 1, "maxItems": 5000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["selection_id", "take_id", "source_start_seconds", "source_end_seconds", "target_start_seconds"],
        "properties": {
          "selection_id": { "type": "string", "minLength": 1 },
          "take_id": { "type": "string", "minLength": 1 },
          "source_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "target_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "source_start_seconds": { "type": "number", "minimum": 0 },
          "source_end_seconds": { "type": "number", "minimum": 0 },
          "target_start_seconds": { "type": "number", "minimum": 0 },
          "target_end_seconds": { "type": "number", "minimum": 0 },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
