{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "COMP3888 canonical CueSheet 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sheet_type", "cues"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "sheet_type": { "const": "cue" },
    "production_title": { "type": "string", "minLength": 1 },
    "episode_title": { "type": "string", "minLength": 1 },
    "territory": { "type": "string", "minLength": 1 },
    "cues": {
      "type": "array", "minItems": 1, "maxItems": 5000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["cue_id", "start_seconds"],
        "anyOf": [{ "required": ["duration_seconds"] }, { "required": ["end_seconds"] }],
        "properties": {
          "cue_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "composer": { "type": "string" },
          "publisher": { "type": "string" },
          "usage": { "type": "string" },
          "isrc": { "type": "string" },
          "iswc": { "type": "string" },
          "asset_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "start_seconds": { "type": "number", "minimum": 0 },
          "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "end_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
