{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.edu.au/csec3888/common/scoring-request.proposal.schema.json",
  "title": "Candidate partner scoring request",
  "description": "Target-facing request. It deliberately contains no private oracle, attack label, expected decision, key path, or evaluator note.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "profile",
    "bundle",
    "objects",
    "options"
  ],
  "properties": {
    "schema_version": { "const": "0.2-candidate" },
    "run_id": { "type": "string", "format": "uuid" },
    "case_id": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "bundle": { "$ref": "#/$defs/publicBundle" },
    "objects": {
      "description": "SHA-256 to bundle-relative media URI map. Implementations must reject traversal outside the supplied bundle root.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[0-9a-f]{64}$" },
      "additionalProperties": {
        "type": "string",
        "pattern": "^objects/[0-9a-f]{64}\\.(?:png|mp4|wav)$"
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include_reasoning", "offline_only", "timeout_seconds"],
      "properties": {
        "include_reasoning": { "type": "boolean" },
        "offline_only": { "type": "boolean" },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "hash-method", "relationship"],
      "properties": {
        "hash": { "$ref": "#/$defs/sha256" },
        "hash-method": { "const": "sha256" },
        "relationship": { "type": "string", "minLength": 1 }
      }
    },
    "artefact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "hash-method", "type", "evidence"],
      "properties": {
        "hash": { "$ref": "#/$defs/sha256" },
        "hash-method": { "const": "sha256" },
        "type": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "publicBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "final-artefact", "artefacts"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "final-artefact": { "$ref": "#/$defs/sha256" },
        "artefacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artefact" }
        }
      }
    }
  }
}
